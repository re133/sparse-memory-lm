# Copy to /workspace/smlm-cloud-kit/cloud.env on the Pod (the kit on your PC already has one; never commit it).

# private GitHub repository (code + results); the Pod uses the deploy key smlm-cloud-kit/deploy_key
GIT_REMOTE=git@github.com:re133/sparse-memory-lm.git
GIT_NAME=leon
GIT_EMAIL=you@example.com

# where repository, Python environment, data and checkpoints live: must be on the volume disk, which survives
# a Pod stop (the container disk does not)
REPO_DIR=/workspace/AngryAnt

# No Runpod API key needed: Runpod puts a Pod-scoped key (RUNPOD_API_KEY) and RUNPOD_POD_ID into every Pod;
# cloud/stop_pod.sh uses them to stop the Pod when the queue is done.

# optional: phone notifications via the ntfy app (subscribe to the same topic; pick a long random name)
NTFY_TOPIC=

# optional overrides
# TORCH_INDEX=https://download.pytorch.org/whl/cu128
# SMLM_MAX_HOURS=12        # hard limit for the whole queue, then the Pod is stopped
# SMLM_STALL_MIN=30        # a run whose logs do not change for this long is terminated

# step 1 (dense queue, scripts/run_dense.py + cloud/setup_dense.sh): cost cap for the whole Pod (budget gate,
# hard stop, independent watchdog) at the hourly price shown when the Pod was created
SMLM_COST_CAP_USD=18
SMLM_PRICE_USD_H=3.49

# storage box (Hetzner sub-account) for data and checkpoints; the kit holds its private key as storagebox_key
STORAGEBOX_HOST=uXXXXXX-subN.your-storagebox.de
STORAGEBOX_USER=uXXXXXX-subN
