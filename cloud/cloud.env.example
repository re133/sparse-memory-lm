# Copy to ~/smlm-cloud-kit/cloud.env and fill in (never commit this file).

# private GitHub repository (code + results); the VM uses the deploy key ~/smlm-cloud-kit/deploy_key
GIT_REMOTE=git@github.com:re133/sparse-memory-lm.git
GIT_NAME=leon
GIT_EMAIL=you@example.com

# IONOS Cloud API: lets the VM stop itself when the queue is done (an OS shutdown does NOT stop billing).
# Token: DCD > Management > Token Manager > Generate token (choose a short lifetime, e.g. 2 days).
# Data center ID and server ID: DCD > Virtual Data Centers > your data center > select the GPU server ->
# both UUIDs are shown in the Inspector (or: GET https://api.ionos.com/cloudapi/v6/datacenters?depth=2).
IONOS_TOKEN=
IONOS_DATACENTER_ID=
IONOS_SERVER_ID=

# optional: phone notifications via the ntfy app (subscribe to the same topic; pick a long random name)
NTFY_TOPIC=

# optional overrides
# TORCH_INDEX=https://download.pytorch.org/whl/cu128
# SMLM_MAX_HOURS=12        # hard limit for the whole queue, then the VM is stopped
# SMLM_STALL_MIN=30        # a run whose logs do not change for this long is terminated
